<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Dashboard</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/styles.css"></head>
<body><div class="d-flex"><aside class="sidebar bg-success text-white p-3"><h4>ClassVault</h4><p>Student: <%= user.name %></p><a class="text-white d-block" href="#notes">Notes</a><a class="text-white d-block" href="#assignments">Assignments</a><a class="text-white d-block" href="#marks">Marks</a><a class="text-white d-block" href="#attendance">Attendance</a><a class="btn btn-outline-light btn-sm mt-3" href="/logout">Logout</a></aside>
<main class="flex-grow-1 p-4 bg-light min-vh-100"><h3>Student Dashboard</h3><div class="row g-3 mb-3"><div class="col-md-3"><div class="card"><div class="card-body">Subjects Enrolled: <strong><%= stats.subjects %></strong></div></div></div><div class="col-md-3"><div class="card"><div class="card-body">Pending Assignments: <strong><%= stats.pendingAssignments %></strong></div></div></div><div class="col-md-3"><div class="card"><div class="card-body">Marks Received: <strong><%= stats.marksReceived %></strong></div></div></div><div class="col-md-3"><div class="card"><div class="card-body">Attendance %: <strong><%= stats.attendancePercent %></strong></div></div></div></div>
<div id="notes" class="card mb-3"><div class="card-body"><h5>Notes</h5><ul><% notes.forEach(n=>{ %><li><%= n.title %> - <%= n.subject_name %> <a href="<%= n.file_path %>" download>Download</a></li><% }) %></ul></div></div>
<div id="assignments" class="card mb-3"><div class="card-body"><h5>Assignments</h5><table class="table table-sm"><tr><th>Title</th><th>Deadline</th><th>Submit</th></tr><% assignments.forEach(a=>{ %><tr><td><%= a.title %></td><td><%= a.deadline %></td><td><form method="POST" enctype="multipart/form-data" action="/student/assignments/submit" class="d-flex gap-1"><input type="hidden" name="assignment_id" value="<%= a.id %>"><input type="file" class="form-control form-control-sm" name="submission_file" required><button class="btn btn-sm btn-primary">Submit</button></form></td></tr><% }) %></table></div></div>
<div id="marks" class="card mb-3"><div class="card-body"><h5>Marks</h5><ul><% submissions.forEach(s=>{ if (s.final_marks !== null && s.final_marks !== undefined) { %><li><%= s.assignment_title %>: <%= s.final_marks %> <% if (s.is_late) { %><span class="badge text-bg-warning">Late submission penalty applied.</span><% } %></li><% } }) %></ul></div></div>
<div id="attendance" class="card"><div class="card-body"><h5>Attendance History</h5><ul><% attendance.forEach(a=>{ %><li><%= a.date %> - <%= a.subject_name %>: <%= a.status %></li><% }) %></ul></div></div>
</main></div></body></html>
