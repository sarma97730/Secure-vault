<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Teacher Dashboard</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/styles.css"></head>
<body><div class="d-flex"><aside class="sidebar bg-primary text-white p-3"><h4>ClassVault</h4><p>Teacher: <%= user.name %></p><a class="text-white d-block" href="#notes">Notes</a><a class="text-white d-block" href="#assignments">Assignments</a><a class="text-white d-block" href="#submissions">Submissions</a><a class="text-white d-block" href="#attendance">Attendance</a><a class="btn btn-outline-light btn-sm mt-3" href="/logout">Logout</a></aside>
<main class="flex-grow-1 p-4 bg-light min-vh-100"><h3>Teacher Dashboard</h3><div class="row g-3 mb-3"><div class="col-md-4"><div class="card"><div class="card-body">Notes Uploaded: <strong><%= stats.notes %></strong></div></div></div><div class="col-md-4"><div class="card"><div class="card-body">Assignments: <strong><%= stats.assignments %></strong></div></div></div><div class="col-md-4"><div class="card"><div class="card-body">Attendance Records: <strong><%= stats.attendance %></strong></div></div></div></div>
<div id="notes" class="card mb-3"><div class="card-body"><h5>Upload Notes</h5><form class="row g-2" method="POST" enctype="multipart/form-data" action="/teacher/notes/upload"><div class="col-md-3"><input name="title" class="form-control" placeholder="Title" required></div><div class="col-md-3"><select name="subject_id" class="form-select" required><% subjects.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-4"><input type="file" name="note_file" class="form-control" required></div><div class="col-md-2"><button class="btn btn-primary w-100">Upload</button></div></form><ul class="mt-3"><% notes.forEach(n=>{ %><li><%= n.title %> (<%= n.subject_name %>) <a href="<%= n.file_path %>">Download</a> <form method="POST" action="/teacher/notes/delete/<%= n.id %>" class="d-inline"><button class="btn btn-sm btn-danger">Delete</button></form></li><% }) %></ul></div></div>
<div id="assignments" class="card mb-3"><div class="card-body"><h5>Create Assignment</h5><form class="row g-2" method="POST" enctype="multipart/form-data" action="/teacher/assignments/create"><div class="col-md-2"><input name="title" class="form-control" placeholder="Title" required></div><div class="col-md-2"><input name="description" class="form-control" placeholder="Description"></div><div class="col-md-2"><select name="subject_id" class="form-select"><% subjects.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-2"><input type="datetime-local" name="deadline" class="form-control" required></div><div class="col-md-1"><input type="number" name="max_marks" class="form-control" placeholder="Max" required></div><div class="col-md-1"><input type="number" name="late_penalty" class="form-control" placeholder="Penalty" value="0"></div><div class="col-md-1"><input type="file" name="assignment_file" class="form-control"></div><div class="col-md-1"><button class="btn btn-success w-100">Add</button></div></form></div></div>
<div id="submissions" class="card mb-3"><div class="card-body"><h5>Submissions & Marks</h5><table class="table table-sm"><tr><th>Student</th><th>Assignment</th><th>Late</th><th>Marks</th><th>Final</th><th>Enter</th></tr><% submissions.forEach(s=>{ %><tr><td><%= s.student_name %></td><td><%= s.assignment_title %></td><td><%= s.is_late ? 'Yes':'No' %></td><td><%= s.marks_obtained ?? '-' %></td><td><%= s.final_marks ?? '-' %></td><td><form class="d-flex gap-1" method="POST" action="/teacher/marks/enter"><input type="hidden" name="submission_id" value="<%= s.id %>"><input name="marks_obtained" type="number" class="form-control form-control-sm" placeholder="Marks" required><input name="comments" class="form-control form-control-sm" placeholder="Comments"><button class="btn btn-sm btn-warning">Save</button></form></td></tr><% }) %></table></div></div>
<div id="attendance" class="card"><div class="card-body"><h5>Mark Attendance</h5><form class="row g-2" method="POST" action="/teacher/attendance/mark"><div class="col-md-3"><select name="student_id" class="form-select"><% students.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-3"><select name="subject_id" class="form-select"><% subjects.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-3"><input type="date" name="date" class="form-control" required></div><div class="col-md-2"><select name="status" class="form-select"><option>Present</option><option>Absent</option></select></div><div class="col-md-1"><button class="btn btn-dark w-100">Mark</button></div></form></div></div>
</main></div></body></html>
