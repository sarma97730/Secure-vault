<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/styles.css"></head>
<body>
<div class="d-flex">
  <aside class="sidebar bg-dark text-white p-3"><h4>ClassVault</h4><p>Admin: <%= user.name %></p><a class="text-white d-block" href="#users">Users</a><a class="text-white d-block" href="#subjects">Subjects</a><a class="text-white d-block" href="#timetable">Timetable</a><a class="text-white d-block" href="#activity">Activity</a><a class="btn btn-outline-light btn-sm mt-3" href="/logout">Logout</a></aside>
  <main class="flex-grow-1 p-4 bg-light min-vh-100">
    <h3>Admin Dashboard</h3>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="row g-3 mb-4"><% ['totalUsers','totalTeachers','totalStudents','totalSubjects','totalAssignments'].forEach(k=>{ %><div class="col-md-2"><div class="card"><div class="card-body"><small><%= k %></small><h4><%= stats[k] %></h4></div></div></div><% }) %></div>
    <div id="users" class="card mb-3"><div class="card-body"><h5>Create User</h5><form class="row g-2" method="POST" action="/admin/users/create"><div class="col-md-3"><input name="name" class="form-control" placeholder="Name" required></div><div class="col-md-3"><input name="email" class="form-control" placeholder="Email" required></div><div class="col-md-2"><input name="password" class="form-control" placeholder="Password" required></div><div class="col-md-2"><select name="role" class="form-select"><option value="teacher">Teacher</option><option value="student">Student</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Create</button></div></form>
      <table class="table mt-3"><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr><% users.forEach(u=>{ %><tr><td><%= u.id %></td><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><form class="d-inline" method="POST" action="/admin/users/delete/<%= u.id %>"><button class="btn btn-sm btn-danger">Delete</button></form></td></tr><% }) %></table></div></div>
    <div id="subjects" class="card mb-3"><div class="card-body"><h5>Manage Subjects</h5><form class="row g-2 mb-4" method="POST" action="/admin/subjects/create"><div class="col-md-3"><input name="name" class="form-control" placeholder="Subject name" required></div><div class="col-md-4"><input name="description" class="form-control" placeholder="Description"></div><div class="col-md-3"><select name="staff_id" class="form-select"><option value="">Assign teacher</option><% teachers.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-success w-100">Add</button></div></form>
      <div class="table-responsive"><table class="table"><tr><th>Subject</th><th>Description</th><th>Assigned Staff</th><th>Update Assignment</th></tr><% subjects.forEach(s=>{ %><tr><td><%= s.name %></td><td><%= s.description || '' %></td><td><%= s.staff_name || 'Unassigned' %></td><td><form class="row g-2" method="POST" action="/admin/subjects/update"><input type="hidden" name="id" value="<%= s.id %>"><input type="hidden" name="name" value="<%= s.name %>"><input type="hidden" name="description" value="<%= s.description || '' %>"><div class="col-md-8"><select name="staff_id" class="form-select form-select-sm"><option value="">Unassigned</option><% teachers.forEach(t=>{ %><option value="<%= t.id %>" <%= Number(s.staff_id) === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %></select></div><div class="col-md-4"><button class="btn btn-sm btn-outline-primary w-100">Save</button></div></form></td></tr><% }) %></table></div></div></div>
    <div id="timetable" class="card mb-3"><div class="card-body"><h5>Manage Timetable</h5><form class="row g-2 mb-3" method="POST" action="/admin/timetable/create"><div class="col-md-4"><select name="subject_id" class="form-select" required><option value="">Select subject</option><% subjects.forEach(s=>{ if (s.staff_id) { %><option value="<%= s.id %>"><%= s.name %> - <%= s.staff_name %></option><% } }) %></select></div><div class="col-md-4"><select name="staff_id" class="form-select" required><option value="">Select assigned staff</option><% teachers.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></div><div class="col-md-2"><select name="day" class="form-select" required><option value="Monday">Monday</option><option value="Tuesday">Tuesday</option><option value="Wednesday">Wednesday</option><option value="Thursday">Thursday</option><option value="Friday">Friday</option><option value="Saturday">Saturday</option></select></div><div class="col-md-1"><input name="time" type="time" class="form-control" required></div><div class="col-md-1"><button class="btn btn-dark w-100">Add Slot</button></div></form>
      <ul class="mb-0"><% timetableEntries.forEach(entry => { %><li><strong><%= entry.subject_name %></strong> - <%= entry.staff_name %> - <%= entry.day %> at <%= entry.time %></li><% }) %></ul></div></div>
    <div id="activity" class="card"><div class="card-body"><h5>System Activity</h5><ul><% activities.forEach(a=> { %><li><%= a.created_at %> - <%= a.action %></li><% }) %></ul></div></div>
  </main>
</div>
</body></html>
